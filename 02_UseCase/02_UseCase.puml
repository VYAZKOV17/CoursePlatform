@startuml
left to right direction
actor Student
actor Instructor
actor Admin

rectangle CoursePlatform {
  usecase "Просмотреть каталог курсов" as UC1
  usecase "Просмотреть информацию о курсе" as UC2
  usecase "Записаться на курс" as UC3
  usecase "Отслеживать прогресс" as UC4
  usecase "Пройти урок" as UC5
  usecase "Получить сертификат" as UC6
  usecase "Создать курс" as UC7
  usecase "Проверить курс перед публикацией" as UC8

  UC3 .> UC2 : <<include>>
  UC6 .> UC4 : <<extend>>
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Instructor --> UC7
Admin --> UC8
@enduml
